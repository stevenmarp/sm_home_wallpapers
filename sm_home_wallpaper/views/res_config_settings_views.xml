<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_home_wallpaper" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.home.wallpaper</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='performance']" position="after">
                <h2>Home Screen Wallpaper</h2>
                <div class="row mt16 o_settings_container" name="sm_home_wallpaper">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="sm_wallpaper_ids" string="Background Images"/>
                            <div class="text-muted">
                                Upload images to use as random home screen wallpapers. A random image is displayed each time you visit the home screen.
                            </div>
                            <div class="content-group mt16">
                                <field name="sm_wallpaper_ids" widget="many2many_binary"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
